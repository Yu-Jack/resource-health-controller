#!/bin/bash
set -e

source $(dirname $0)/version

cd $(dirname $0)/..

echo "Building binaries..."

mkdir -p bin

LINKFLAGS="-X main.AppVersion=$VERSION
           -X main.GitCommit=$COMMIT"

for arch in "amd64" "arm64"; do
    GOARCH="$arch" CGO_ENABLED=0 go build -ldflags "-s -w $LINKFLAGS" -o bin/resource-health-controller-"$arch" ./cmd/controller
done
